table Combustible

	column 'month'
		dataType: string
		summarizeBy: none
		sourceColumn: month

	column 'vehicle_type'
		dataType: string
		summarizeBy: none
		sourceColumn: vehicle_type

	column 'fuel_type'
		dataType: string
		summarizeBy: none
		sourceColumn: fuel_type

	column 'trip_count'
		dataType: double
		summarizeBy: none
		sourceColumn: trip_count

	column 'total_fuel_liters'
		dataType: double
		summarizeBy: none
		sourceColumn: total_fuel_liters

	column 'total_distance_km'
		dataType: double
		summarizeBy: none
		sourceColumn: total_distance_km

	measure KPI_trip_count_Combustible = SUM(Combustible[trip_count])
		formatString: #,0.00
		displayFolder: Indicadores

	measure KPI_total_fuel_liters_Combustible = SUM(Combustible[total_fuel_liters])
		formatString: #,0.00
		displayFolder: Indicadores

	measure KPI_total_distance_km = SUM(Combustible[total_distance_km])
		formatString: #,0.00
		displayFolder: Indicadores

	measure KPI_Eficiencia = DIVIDE(SUM(Combustible[total_fuel_liters])*100, SUM(Combustible[total_distance_km]))
		formatString: #,0.00
		displayFolder: Indicadores

	measure KPI_total_distance_km_Estado = IF(COUNTROWS(Combustible)=0, "Datos pendientes", FORMAT([KPI_total_distance_km], "#,0.00"))
		formatString: General

	measure KPI_total_fuel_liters_Estado_Combustible = IF(COUNTROWS(Combustible)=0, "Datos pendientes", FORMAT([KPI_total_fuel_liters_Combustible], "#,0.00"))
		formatString: General

	measure KPI_Eficiencia_Estado = IF(COUNTROWS(Combustible)=0, "Datos pendientes", FORMAT([KPI_Eficiencia], "#,0.00"))
		formatString: General

	measure KPI_trip_count_Estado_Combustible = IF(COUNTROWS(Combustible)=0, "Datos pendientes", FORMAT([KPI_trip_count_Combustible], "#,0.00"))
		formatString: General

	partition Combustible = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Combustible.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"month", type text}, {"vehicle_type", type text}, {"fuel_type", type text}, {"trip_count", type number}, {"total_fuel_liters", type number}, {"total_distance_km", type number}}, "en-US")
				in
				    Typed
